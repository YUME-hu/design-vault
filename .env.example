# 复制为 .env.local 后再填值。M0 不需要任何一项即可跑通全部功能。
# 真实值永远不要提交到 git（.env.local 已在 .gitignore 中）。

# --- M2：B 站收藏夹 / 视频信息（只读，用主账号 SESSDATA）---
BILIBILI_SESSDATA=

# --- M2：DeepSeek 文本抽取（严格 JSON）---
DEEPSEEK_API_KEY=
# 默认官方地址，不填即可
DEEPSEEK_BASE_URL=

# --- M2：GitHub README（可选，不填走 60 次/小时匿名额度）---
GITHUB_TOKEN=

# --- M3：视觉兜底（models 固定为 deepseek-flash，写死在代码里）---
VISION_MODEL=deepseek-flash

