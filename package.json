{
  "name": "design-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Personal frontend style vault: capture real designs, derive OKLCH palettes, preview them live in a DSH plugin, and export AI-ready design configs.",
  "author": "梦澐子",
  "license": "MIT",
  "keywords": [
    "design-system",
    "design-tokens",
    "oklch",
    "color-palette",
    "wcag-contrast",
    "nextjs",
    "deepseek-harness",
    "dsh-plugin",
    "motion-design"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-data.ts",
    "verify:m0": "node scripts/verify-m0.mjs",
    "verify:m1a": "node scripts/verify-m1a.mjs",
    "test:color": "tsx scripts/test-color.ts",
    "verify:m1b": "node scripts/verify-m1b.mjs",
    "verify:m2a": "tsx scripts/verify-m2a.mts",
    "verify:m2b": "tsx scripts/verify-m2b.mts",
    "migrate:sources": "tsx scripts/migrate-sources.ts",
    "verify:m3a": "tsx scripts/verify-m3a.mts",
    "verify:m3b": "tsx scripts/verify-m3b.mts",
    "verify:m4a": "tsx scripts/verify-m4a.mts",
    "verify:m4b": "tsx scripts/verify-m4b.mts",
    "ingest:now": "tsx scripts/scheduled-ingest.mts",
    "backup": "tsx scripts/backup.mts",
    "verify:m5": "tsx scripts/verify-m5.mts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/noto-sans-sc": "^5.1.1",
    "@fontsource/space-mono": "^5.1.1",
    "adm-zip": "^0.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
