{
  "name": "design-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Personal frontend style vault: capture real designs, derive OKLCH palettes, preview them live in a DSH plugin, and export AI-ready design configs.",
  "author": "梦澐子",
  "license": "MIT",
  "keywords": [
    "design-system",
    "design-tokens",
    "oklch",
    "color-palette",
    "wcag-contrast",
    "nextjs",
    "deepseek-harness",
    "dsh-plugin",
    "motion-design"
  ],
  "scripts": {
    "dev": "corepack pnpm --filter @design-vault/web dev",
    "build": "corepack pnpm --filter @design-vault/web build",
    "start": "corepack pnpm --filter @design-vault/web start",
    "typecheck": "tsc --noEmit && corepack pnpm --filter @design-vault/web typecheck",
    "validate": "tsx scripts/validate-data.ts",
    "test:color": "tsx scripts/test-color.ts",
    "verify:m0": "node scripts/verify-m0.mjs",
    "verify:m1a": "node scripts/verify-m1a.mjs",
    "verify:m1b": "node scripts/verify-m1b.mjs",
    "verify:m2a": "tsx scripts/verify-m2a.mts",
    "verify:m2b": "tsx scripts/verify-m2b.mts",
    "verify:m3a": "tsx scripts/verify-m3a.mts",
    "verify:m3b": "tsx scripts/verify-m3b.mts",
    "verify:m4a": "tsx scripts/verify-m4a.mts",
    "verify:m4b": "tsx scripts/verify-m4b.mts",
    "verify:m5": "tsx scripts/verify-m5.mts",
    "migrate:sources": "tsx scripts/migrate-sources.ts",
    "ingest:now": "tsx scripts/scheduled-ingest.mts",
    "backup": "tsx scripts/backup.mts"
  },
  "dependencies": {
    "@design-vault/adapters": "workspace:*",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.10.2",
    "playwright": "^1.49.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "type": "module"
}
