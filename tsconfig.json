{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@design-vault/core": [
        "./packages/core/src/index.ts"
      ],
      "@design-vault/core/*": [
        "./packages/core/src/*"
      ],
      "@design-vault/store": [
        "./packages/store/src/index.ts"
      ],
      "@design-vault/store/*": [
        "./packages/store/src/*"
      ],
      "@design-vault/adapters": [
        "./packages/adapters/src/index.ts"
      ],
      "@design-vault/adapters/*": [
        "./packages/adapters/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "scripts/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps",
    ".next"
  ]
}
